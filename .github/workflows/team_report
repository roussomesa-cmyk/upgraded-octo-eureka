name: Run Team Pass Report

on:
  workflow_dispatch:
    inputs:
      mode:
        description: 'Select Mode'
        required: true
        default: 'daily'
        type: choice
        options:
          - daily
          - weekly
          - final
      week_num:
        description: 'Week number (for weekly mode: 1-4)'
        required: false
        default: '2'
        type: string

jobs:
  run-report:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'

      - name: Install system dependencies (for dataframe_image)
        run: |
          sudo apt-get update
          sudo apt-get install -y libglib2.0-0 libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libdbus-1-3 libxkbcommon0 libatspi0 libgbm1 libasound2

      - name: Install Python dependencies
        run: |
          pip install --upgrade pip
          pip install pandas requests dataframe_image telethon

      - name: Run Python script
        env:
          SPREADSHEET_ID: ${{ secrets.SPREADSHEET_ID }}
          NOTIFY_GROUP_ID: ${{ secrets.NOTIFY_GROUP_ID }}
          TELEGRAM_API_ID: ${{ secrets.TELEGRAM_API_ID }}
          TELEGRAM_API_HASH: ${{ secrets.TELEGRAM_API_HASH }}
          TELEGRAM_SESSION: ${{ secrets.TELEGRAM_SESSION }}
        run: |
          if [ "${{ github.event.inputs.mode }}" = "weekly" ]; then
            python team_pass_report.py weekly --week ${{ github.event.inputs.week_num }}
          else
            python team_pass_report.py ${{ github.event.inputs.mode }}
          fi
